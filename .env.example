# CloudSentinel Platform Configuration

# Server Ports and URLs
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Monitoring Engine Frequencies & Timeouts (seconds)
HEALTH_INTERVAL=3
HEARTBEAT_TIMEOUT=10
RECOVERY_TIMEOUT=15

# Intelligent Health Thresholds (%)
CPU_WARNING_THRESHOLD=75.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=75.0
MEMORY_CRITICAL_THRESHOLD=90.0
RESPONSE_TIME_WARNING_MS=500
RESPONSE_TIME_CRITICAL_MS=2000

# Zombie & Idle Detection
IDLE_THRESHOLD=5.0
IDLE_DURATION=120

# Health Score Weights (Must sum to 1.0)
WEIGHT_CPU=0.20
WEIGHT_RAM=0.20
WEIGHT_NETWORK=0.10
WEIGHT_RESPONSE_TIME=0.20
WEIGHT_HEARTBEAT=0.20
WEIGHT_APPLICATION=0.10

# Firebase Configuration (Leave empty to use Local Demo Mode)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Mode
DEMO_MODE=true
